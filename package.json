{
  "name": "species-presentation-analyst",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "overrides": {
    "nf3": "0.3.17"
  },
  "scripts": {
    "dev": "node scripts/with-app-env.mjs vite dev --host 0.0.0.0 --port 8080",
    "build": "npm run build:sitemap && node scripts/with-app-env.mjs vite build",
    "build:sitemap": "node --experimental-strip-types scripts/build-sitemap.mjs",
    "db:seed-dossiers": "node --experimental-strip-types scripts/seed-dossiers.mjs",
    "validate:dossiers": "node --experimental-strip-types scripts/validate-dossiers.mjs data/dossiers",
    "report:freshness": "node --experimental-strip-types scripts/report-freshness.mjs",
    "report:coverage": "node --experimental-strip-types scripts/report-coverage.mjs",
    "report:duplicates": "node --experimental-strip-types scripts/report-duplicates.mjs",
    "check:sources": "node --experimental-strip-types scripts/check-sources.mjs",
    "review:queue": "node --experimental-strip-types scripts/review-queue.mjs",
    "species:brief": "node --experimental-strip-types scripts/species-brief.mjs",
    "build:dev": "node scripts/with-app-env.mjs vite build --mode development",
    "preview": "node scripts/with-app-env.mjs vite preview",
    "preview:restart": "node scripts/preview.mjs restart",
    "preview:stop": "node scripts/preview.mjs stop",
    "typecheck": "tsc --noEmit",
    "test": "npm run validate:dossiers && node --test 'scripts/**/*.test.mjs' && node --experimental-strip-types --test 'src/**/*.test.ts'",
    "lint": "eslint .",
    "format": "prettier --write .",
    "verify": "npm run typecheck && npm run lint && npx prettier --check src && npm test"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-router": "^1.170.0",
    "@tanstack/react-start": "^1.168.0",
    "@tanstack/router-plugin": "^1.168.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.510.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "@types/node": "^22.16.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.20.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^6.0.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^15.15.0",
    "lightningcss": "^1.28.0",
    "nitro": "3.0.260610-beta",
    "playwright": "^1.62.0",
    "prettier": "^3.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.56.1",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "workbox-build": "^7.4.1",
    "workbox-window": "7.4.1"
  }
}
